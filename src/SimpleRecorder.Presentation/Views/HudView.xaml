<UserControl
    x:Class="SimpleRecorder.Presentation.Views.HudView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SimpleRecorder.Presentation.Views"
    mc:Ignorable="d">

    <Grid Width="560" Padding="16">
        <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" Spacing="12">
            <Border
                Background="{Binding FeedbackBrush}"
                CornerRadius="16"
                Padding="12,8"
                Visibility="{Binding FeedbackVisibility}">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="13"
                    Foreground="Black"
                    Text="{Binding FeedbackText}" />
            </Border>

            <Border
                Background="#FFE8E3DB"
                CornerRadius="32"
                Padding="20"
                Visibility="{Binding SettingsVisibility}">
                <local:SettingsFlyout />
            </Border>

            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Border
                    Background="#FF161616"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Background="#FF262626" BorderBrush="#1FFFFFFF" BorderThickness="1" Command="{Binding SelectDisplaySourceCommand}" CornerRadius="999" FontFamily="Segoe UI Variable Display" FontSize="12" IsChecked="{Binding IsDisplaySelected}" MinWidth="104" Padding="12,6">
                            <TextBlock Text="Screen 1" />
                        </ToggleButton>
                        <ToggleButton Background="#FF262626" BorderBrush="#1FFFFFFF" BorderThickness="1" Command="{Binding SelectWindowSourceCommand}" CornerRadius="999" FontFamily="Segoe UI Variable Display" FontSize="12" IsChecked="{Binding IsWindowSelected}" MinWidth="104" Padding="12,6">
                            <TextBlock Text="Window" />
                        </ToggleButton>
                        <ToggleButton Background="#FF262626" BorderBrush="#1FFFFFFF" BorderThickness="1" Command="{Binding SelectRegionSourceCommand}" CornerRadius="999" FontFamily="Segoe UI Variable Display" FontSize="12" IsChecked="{Binding IsRegionSelected}" MinWidth="104" Padding="12,6">
                            <TextBlock Text="Region" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Border
                    Background="#FF262626"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="13"
                            Foreground="White"
                            Text="{Binding StatusText}" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="13"
                            Foreground="#FFFF3040"
                            Text="{Binding CountdownLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="24">
                <Button
                    Background="{Binding MicrophoneButtonBrush}"
                    Command="{Binding ToggleMicrophoneCommand}"
                    CornerRadius="999"
                    Height="52"
                    ToolTipService.ToolTip="Toggle microphone"
                    Width="52">
                    <FontIcon FontSize="18" Foreground="{Binding MicrophoneGlyphForeground}" Glyph="&#xE720;" />
                </Button>

                <Button
                    Background="{Binding SecondaryButtonBrush}"
                    Command="{Binding SecondaryActionCommand}"
                    CornerRadius="999"
                    Height="52"
                    IsEnabled="{Binding IsSecondaryActionEnabled}"
                    ToolTipService.ToolTip="{Binding SecondaryActionToolTip}"
                    Width="52">
                    <FontIcon FontSize="18" Foreground="{Binding SecondaryGlyphForeground}" Glyph="{Binding SecondaryActionGlyph}" />
                </Button>

                <Button
                    Background="{Binding PrimaryButtonBrush}"
                    Command="{Binding PrimaryActionCommand}"
                    CornerRadius="999"
                    Height="72"
                    ToolTipService.ToolTip="Record or stop"
                    Width="72">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="28"
                        Foreground="{Binding PrimaryGlyphForeground}"
                        HorizontalAlignment="Center"
                        Text="{Binding PrimaryActionGlyph}"
                        VerticalAlignment="Center" />
                </Button>

                <Button
                    x:Name="SettingsButton"
                    Background="#FFE8E3DB"
                    Command="{Binding ToggleSettingsCommand}"
                    CornerRadius="999"
                    Height="52"
                    ToolTipService.ToolTip="Open settings"
                    Width="52">
                    <FontIcon FontSize="18" Foreground="Black" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
