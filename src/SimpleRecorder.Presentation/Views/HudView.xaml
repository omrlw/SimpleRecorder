<UserControl
    x:Class="SimpleRecorder.Presentation.Views.HudView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SimpleRecorder.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:OptionDisplayConverter x:Key="OptionDisplayConverter" />
    </UserControl.Resources>

    <Border
        Background="#171717"
        BorderBrush="#353535"
        BorderThickness="1"
        CornerRadius="12"
        Padding="18"
        RequestedTheme="Dark">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentPanel"
                Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F5"
                        Text="SimpleRecorder" />
                    <TextBlock
                        Foreground="#C9C9C9"
                        Text="{Binding SessionStateLabel}" />
                    <TextBlock
                        Foreground="#F5F5F5"
                        Text="{Binding StatusText}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="#F59E0B"
                        Text="{Binding FeedbackText}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding FeedbackVisibility}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F5"
                        Text="Source" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Background="{Binding DisplaySourceButtonBackground}"
                            BorderBrush="{Binding DisplaySourceButtonBorderBrush}"
                            Command="{Binding SelectDisplaySourceCommand}"
                            Content="Display"
                            Foreground="{Binding DisplaySourceButtonForeground}"
                            IsEnabled="{Binding IsSourceSelectionEnabled}" />
                        <Button
                            Grid.Column="1"
                            Background="{Binding WindowSourceButtonBackground}"
                            BorderBrush="{Binding WindowSourceButtonBorderBrush}"
                            Command="{Binding SelectWindowSourceCommand}"
                            Content="Window"
                            Foreground="{Binding WindowSourceButtonForeground}"
                            IsEnabled="{Binding IsSourceSelectionEnabled}" />
                        <Button
                            Grid.Column="2"
                            Background="{Binding RegionSourceButtonBackground}"
                            BorderBrush="{Binding RegionSourceButtonBorderBrush}"
                            Command="{Binding SelectRegionSourceCommand}"
                            Content="Region"
                            Foreground="{Binding RegionSourceButtonForeground}"
                            IsEnabled="{Binding IsSourceSelectionEnabled}" />
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#A3A3A3" Text="Current source" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding SelectedSourceSummaryLabel}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#A3A3A3" Text="Capture bounds" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding ExpectedCaptureRegionLabel}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#A3A3A3" Text="Expected output" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Foreground="#F5F5F5" Text="{Binding ExpectedOutputLabel}" />
                            <TextBlock Foreground="#A3A3A3" Text="{Binding ExpectedAdjustmentsLabel}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F5"
                        Text="Actions" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Command="{Binding PrimaryActionCommand}"
                            Content="Start recording"
                            Visibility="{Binding StartActionVisibility}" />

                        <Button
                            Command="{Binding SecondaryActionCommand}"
                            Content="{Binding PauseResumeActionLabel}"
                            IsEnabled="{Binding IsSecondaryActionEnabled}"
                            Visibility="{Binding PauseResumeActionVisibility}" />

                        <Button
                            Command="{Binding PrimaryActionCommand}"
                            Content="{Binding StopActionLabel}"
                            IsEnabled="{Binding IsStopActionEnabled}"
                            Visibility="{Binding StopActionVisibility}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F5"
                        Text="Recording options" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Foreground="#A3A3A3" Text="Frame rate" />
                            <ComboBox
                                IsEnabled="{Binding IsSettingsEnabled}"
                                ItemsSource="{Binding FrameRateOptions}"
                                SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource OptionDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Foreground="#A3A3A3" Text="Resolution" />
                            <ComboBox
                                IsEnabled="{Binding IsSettingsEnabled}"
                                ItemsSource="{Binding ResolutionOptions}"
                                SelectedItem="{Binding SelectedResolutionOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Foreground="#A3A3A3" Text="Quality" />
                            <ComboBox
                                IsEnabled="{Binding IsSettingsEnabled}"
                                ItemsSource="{Binding QualityOptions}"
                                SelectedItem="{Binding SelectedQuality, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource OptionDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Foreground="#A3A3A3" Text="Countdown" />
                            <ComboBox
                                IsEnabled="{Binding IsSettingsEnabled}"
                                ItemsSource="{Binding CountdownOptions}"
                                SelectedItem="{Binding SelectedCountdown, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource OptionDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                            <CheckBox
                                Content="Remember last source"
                                Foreground="#F5F5F5"
                                IsChecked="{Binding RememberLastSource, Mode=TwoWay}"
                                IsEnabled="{Binding IsSettingsEnabled}" />
                            <TextBlock
                                Foreground="#A3A3A3"
                                Text="Audio capture is not active in the current slice, so audio controls are intentionally hidden from this workbench UI."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F5"
                        Text="Output and telemetry" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#A3A3A3" Text="Save directory" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding SaveDirectory}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#A3A3A3" Text="Latest output" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding CurrentOutputPathLabel}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#A3A3A3" Text="Telemetry summary" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding TelemetrySummaryLabel}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Foreground="#A3A3A3" Text="Frames" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding TelemetryFramesLabel}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Foreground="#A3A3A3" Text="Latency" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding TelemetryLatencyLabel}" TextWrapping="WrapWholeWords" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Foreground="#A3A3A3" Text="Queue" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Foreground="#F5F5F5" Text="{Binding TelemetryQueueLabel}" TextWrapping="WrapWholeWords" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
