<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="HudMotionEnterOffset">8</x:Double>
    <x:Double x:Key="HudMotionEnterDurationMs">180</x:Double>
    <x:Double x:Key="HudMotionSettingsRevealDurationMs">160</x:Double>
    <x:Double x:Key="HudMotionRecordingTransitionDurationMs">120</x:Double>
    <x:Double x:Key="HudMotionFeedbackInDurationMs">140</x:Double>
    <x:Double x:Key="HudMotionFeedbackHoldDurationMs">900</x:Double>
    <x:Double x:Key="HudMotionFeedbackOutDurationMs">160</x:Double>
    <TransitionCollection x:Key="HudTransitions">
        <EntranceThemeTransition FromVerticalOffset="{StaticResource HudMotionEnterOffset}" />
        <RepositionThemeTransition />
    </TransitionCollection>
</ResourceDictionary>
