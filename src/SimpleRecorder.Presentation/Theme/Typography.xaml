<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Preferred visual family from SimpleRecorder.pen. Fall back when Google Sans is not installed locally. -->
    <FontFamily x:Key="HudFontFamily">Google Sans, Segoe UI Variable Display, Segoe UI</FontFamily>
    <x:Double x:Key="HudOverlineSize">11</x:Double>
    <x:Double x:Key="HudCaptionSize">12</x:Double>
    <x:Double x:Key="HudBodySize">12</x:Double>
    <x:Double x:Key="HudTitleSize">12</x:Double>
    <x:Double x:Key="HudIconSize">20</x:Double>
    <x:Double x:Key="HudPrimaryGlyphSize">24</x:Double>
</ResourceDictionary>
