<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HudSourceButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource HudSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
    </Style>

    <Style x:Key="HudActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
