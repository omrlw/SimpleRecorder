<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///SimpleRecorder.Presentation/Theme/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///SimpleRecorder.Presentation/Theme/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///SimpleRecorder.Presentation/Theme/Layout.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="HudStatusBannerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource HudSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HudRadiusField}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="{StaticResource HudStatusPadding}" />
    </Style>

    <Style x:Key="HudLightPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HudRadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource HudPanelPadding}" />
    </Style>

    <Style x:Key="HudDarkStripBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HudRadiusPill}" />
        <Setter Property="Padding" Value="{StaticResource HudInfoPadding}" />
    </Style>

    <Style x:Key="HudStaticValuePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HudRadiusPill}" />
        <Setter Property="MinHeight" Value="{StaticResource HudSettingsFieldHeight}" />
        <Setter Property="Padding" Value="{StaticResource HudFieldPadding}" />
        <Setter Property="Width" Value="{StaticResource HudSettingsValueWidth}" />
    </Style>

    <Style x:Key="HudButtonBaseStyle" TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HudRadiusPill}" />
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnDarkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudActionButtonStyle" BasedOn="{StaticResource HudButtonBaseStyle}" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource HudActionButtonSize}" />
        <Setter Property="Width" Value="{StaticResource HudActionButtonSize}" />
    </Style>

    <Style x:Key="HudPrimaryActionButtonStyle" BasedOn="{StaticResource HudActionButtonStyle}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource HudPrimaryActionButtonSize}" />
        <Setter Property="Width" Value="{StaticResource HudPrimaryActionButtonSize}" />
    </Style>

    <Style x:Key="HudSourceButtonStyle" BasedOn="{StaticResource HudButtonBaseStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HudSurfaceAltBrush}" />
        <Setter Property="Height" Value="{StaticResource HudSourceButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource HudSourceButtonPadding}" />
    </Style>

    <Style x:Key="HudSettingsValueButtonStyle" BasedOn="{StaticResource HudButtonBaseStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HudSurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource HudSettingsFieldHeight}" />
        <Setter Property="Padding" Value="{StaticResource HudFieldPadding}" />
        <Setter Property="Width" Value="{StaticResource HudSettingsValueWidth}" />
    </Style>

    <Style x:Key="HudStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudBodySize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnDarkBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="HudFeedbackTextStyle" BasedOn="{StaticResource HudStatusTextStyle}" TargetType="TextBlock" />

    <Style x:Key="HudSourceButtonIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudSourceButtonLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudActionGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource HudIconSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudActionIndicatorDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource HudIndicatorDotSize}" />
        <Setter Property="Height" Value="{StaticResource HudIndicatorDotSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="{StaticResource HudIndicatorDotMargin}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="HudInlineIndicatorDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource HudIndicatorDotSize}" />
        <Setter Property="Height" Value="{StaticResource HudIndicatorDotSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudSettingsGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnLightBrush}" />
    </Style>

    <Style x:Key="HudSettingsLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnLightBrush}" />
    </Style>

    <Style x:Key="HudSettingsValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnDarkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HudMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource HudSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnDarkBrush}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="HudToggleMenuFlyoutItemStyle" TargetType="ToggleMenuFlyoutItem">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HudTextOnDarkBrush}" />
    </Style>
</ResourceDictionary>
