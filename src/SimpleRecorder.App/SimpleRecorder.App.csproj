<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SimpleRecorder.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackage>true</AppxPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleRecorder.Contracts\SimpleRecorder.Contracts.csproj" />
    <ProjectReference Include="..\SimpleRecorder.Infrastructure\SimpleRecorder.Infrastructure.csproj" />
    <ProjectReference Include="..\SimpleRecorder.Presentation\SimpleRecorder.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Audio\*.wav" Link="Audio\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyNativeStub" AfterTargets="Build">
    <ItemGroup>
      <NativeStubArtifact Include="..\SimpleRecorder.Engine.Native\bin\$(Platform)\$(Configuration)\SimpleRecorder.Engine.Native.dll" Condition="Exists('..\SimpleRecorder.Engine.Native\bin\$(Platform)\$(Configuration)\SimpleRecorder.Engine.Native.dll')" />
      <NativeStubArtifact Include="..\SimpleRecorder.Engine.Native\bin\$(Platform)\$(Configuration)\SimpleRecorder.Engine.Native.pdb" Condition="Exists('..\SimpleRecorder.Engine.Native\bin\$(Platform)\$(Configuration)\SimpleRecorder.Engine.Native.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(NativeStubArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(NativeStubArtifact)' != ''" />
  </Target>
</Project>
