<Window
    x:Class="SimpleRecorder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SimpleRecorder.Presentation.Views"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="DragRegion" Grid.Row="0" Background="Transparent" />

        <Border
            Grid.Row="1"
            Margin="8,0,8,8"
            Background="#0D101010"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="32"
            Padding="0">
            <views:HudView x:Name="HudRoot" />
        </Border>
    </Grid>
</Window>
